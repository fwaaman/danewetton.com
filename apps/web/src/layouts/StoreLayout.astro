---
// Assets
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
const { frontmatter } = Astro.props;
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-48">
      <div class="flex flex-col gap-4">
        <div class="max-w-xs">
          <Text tag="h1" variant="textBase" class="font-medium text-base-900">
            {frontmatter.title}
          </Text>
          <Text
            tag="p"
            variant="textSM"
            class="mt-2 italic tracking-tighter text-base-600"
          >
            {frontmatter.description}
          </Text>
        </div>
        <div class="flex">
          <Button isLink href="#_" size="xs" variant="default">
            Buy {frontmatter.title} for ${frontmatter.price}
          </Button>
        </div>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-24 mt-12"
      >
        <div>
          <Text tag="h3" variant="textBase" class="text-base-900 font-medium"
            >Specificatons</Text
          >
          <ul role="list" class="flex flex-col text-xs mt-2">
            {
              frontmatter.specifications.map((spec) => (
                <li>
                  <span class="sr-only">{spec.name}</span>
                  <Text tag="p" variant="textXS" class="text-base-600 ">
                    {spec.value}
                  </Text>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <Text tag="h3" variant="textBase" class="text-base-900 font-medium"
            >Includes</Text
          >
          <ul role="list" class="text-xs">
            {
              frontmatter.highlights.map((highlight) => (
                <li>
                  <Text tag="p" variant="textXS" class="text-base-600 ">
                    {highlight}
                  </Text>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <Text tag="h3" variant="textBase" class="text-base-900 font-medium"
            >License</Text
          >
          <Text tag="p" variant="textXS" class="text-base-600 mt-2">
            {frontmatter.license}
          </Text>
        </div>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-24 mt-12"
      >
        <Image
          width={1000}
          height={1000}
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
        />
        {
          frontmatter.images.map((image) => (
            <Image width={1000} height={1000} src={image.url} alt={image.alt} />
          ))
        }
      </div>
      <div class="mt-12 max-w-xs">
        <Text tag="h3" variant="textBase" class="text-base-900 font-medium"
          >Frequently Asked Questions</Text
        >
        <div class="space-y-4 mt-4">
          {
            frontmatter.faq.map((item) => (
              <details class="select-none">
                <summary class="flex  cursor-pointer ">
                  <Text
                    tag="h4"
                    variant="textSM"
                    class="text-base-900  flex items-center gap-2"
                  >
                    {item.question}
                  </Text>
                </summary>
                <Text tag="p" variant="textXS" class="text-base-600  mt-2">
                  {item.answer}
                </Text>
              </details>
            ))
          }
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
