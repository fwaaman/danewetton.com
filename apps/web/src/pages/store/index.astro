---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import StoreCard from "@/components/store/StoreCard.astro";
// Content
import { getCollection } from "astro:content";
const allProducts = await getCollection("store");
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-48">
      <div class="overflow-hidden">
        <Text tag="h1" variant="textBase" class="font-medium text-base-900">
          Digital products for your business
        </Text>
      </div>

      <div
        class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-y-24 gap-4"
      >
        {allProducts.map((post) => <StoreCard post={post} />)}
      </div>
    </Wrapper>
  </section>
</BaseLayout>
