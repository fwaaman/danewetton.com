---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout
  seo={{
    title: "Contact",
    description: "Contact Dane Wetton about photography and commissioned work.",
  }}
>
  <section>
    <Wrapper variant="standard" class="pt-12 pb-24">
      <nav aria-label="Contact links" class="flex flex-col items-start gap-1">
        <Text
          tag="a"
          variant="textSM"
          href="https://www.instagram.com/danewett/"
          target="_blank"
          rel="noreferrer"
          class="text-base-900 hover:text-base-600 transition duration-300"
        >
          Instagram
        </Text>
        <Text
          tag="a"
          variant="textSM"
          href="mailto:hello@danewetton.com"
          class="text-base-900 hover:text-base-600 transition duration-300"
        >
          Email
        </Text>
      </nav>
    </Wrapper>
  </section>
</BaseLayout>
