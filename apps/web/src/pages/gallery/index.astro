---
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getAllGallery } from "@/lib/data";
import {
  getImageUrl,
  sanityFetch,
  siteSettingsQuery,
} from "@/lib/sanity";
import type { SiteSettings } from "@/lib/sanity";

const galleries = await getAllGallery();
const galleryPhotos = galleries.flatMap((gallery) => [
  gallery.data.thumbnail,
  ...(gallery.data.images ?? []),
]);

const settings = await sanityFetch<SiteSettings | null>(siteSettingsQuery);
const homepagePhotos = (settings?.homepageImages ?? []).map((image, index) => ({
  url: getImageUrl(image, { width: 1600, quality: 90 }),
  alt: image.alt ?? `Photograph ${index + 1}`,
}));

const sourcePhotos = galleryPhotos.length > 0 ? galleryPhotos : homepagePhotos;
const seenUrls = new Set<string>();
const photos = sourcePhotos.filter((photo) => {
  if (seenUrls.has(photo.url)) return false;
  seenUrls.add(photo.url);
  return true;
});
---

<BaseLayout
  hideFooter
  seo={{
    title: "Photos",
    description: "A collection of photographs by Dane Wetton.",
  }}
>
  <div class="flex min-h-[calc(100svh-3.5rem)] flex-col">
    <section class="flex-1">
      <Wrapper variant="standard" class="py-24 lg:pt-32">
        <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
          {
            photos.map((photo, index) => (
              <figure class="mb-4 break-inside-avoid">
                <button
                  type="button"
                  data-lightbox-trigger
                  data-image-src={photo.url}
                  data-image-alt={photo.alt}
                  aria-label={`Enlarge ${photo.alt}`}
                  class="block w-full cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-900"
                >
                  <Image
                    src={photo.url}
                    alt={photo.alt}
                    width={1600}
                    height={1600}
                    loading={index < 3 ? "eager" : "lazy"}
                    decoding="async"
                    class="h-auto w-full"
                  />
                </button>
              </figure>
            ))
          }
        </div>
      </Wrapper>
    </section>

    <footer class="mt-auto">
      <Wrapper variant="standard" class="pb-4">
        <Text tag="p" variant="textXS" class="text-right text-base-400">
          © Copyright Dane Wetton. Photos. Cameras. Musings.
        </Text>
      </Wrapper>
    </footer>
  </div>

  <dialog
    data-lightbox
    aria-label="Enlarged photograph"
    class="m-0 h-svh w-screen max-h-none max-w-none bg-white p-4 backdrop:bg-white"
  >
    <button
      type="button"
      data-lightbox-close
      class="absolute right-4 top-4 z-10 text-xs font-medium uppercase text-base-900 transition duration-300 hover:text-base-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-900"
    >
      Close
    </button>
    <div data-lightbox-backdrop class="flex size-full items-center justify-center">
      <img
        data-lightbox-image
        src=""
        alt=""
        class="max-h-[calc(100svh-2rem)] max-w-full object-contain"
      />
    </div>
  </dialog>
</BaseLayout>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
    "[data-lightbox-image]"
  );
  const lightboxBackdrop = lightbox?.querySelector<HTMLElement>(
    "[data-lightbox-backdrop]"
  );
  const closeButton = lightbox?.querySelector<HTMLButtonElement>(
    "[data-lightbox-close]"
  );
  const triggers = document.querySelectorAll<HTMLButtonElement>(
    "[data-lightbox-trigger]"
  );
  let previousFocus: HTMLElement | null = null;

  const closeLightbox = () => lightbox?.close();

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!lightbox || !lightboxImage) return;

      previousFocus = trigger;
      lightboxImage.src = trigger.dataset.imageSrc ?? "";
      lightboxImage.alt = trigger.dataset.imageAlt ?? "Enlarged photograph";
      document.body.style.overflow = "hidden";
      lightbox.showModal();
      closeButton?.focus();
    });
  });

  closeButton?.addEventListener("click", closeLightbox);
  lightboxBackdrop?.addEventListener("click", (event) => {
    if (event.target === lightboxBackdrop) closeLightbox();
  });
  lightbox?.addEventListener("close", () => {
    document.body.style.overflow = "";
    lightboxImage?.removeAttribute("src");
    previousFocus?.focus();
  });
</script>
