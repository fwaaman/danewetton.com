---
import { Image } from "astro:assets";
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Content
import { getAllGallery } from "@/lib/data";
import {
  getImageUrl,
  sanityFetch,
  siteSettingsQuery,
} from "@/lib/sanity";
import type { SiteSettings } from "@/lib/sanity";

const galleries = await getAllGallery();
const galleryPhotos = galleries.flatMap((gallery) => [
  gallery.data.thumbnail,
  ...(gallery.data.images ?? []),
]);

const settings = await sanityFetch<SiteSettings | null>(siteSettingsQuery);
const homepagePhotos = (settings?.homepageImages ?? []).map((image, index) => ({
  url: getImageUrl(image, { width: 1600, quality: 90 }),
  alt: image.alt ?? `Photograph ${index + 1}`,
}));

const sourcePhotos = galleryPhotos.length > 0 ? galleryPhotos : homepagePhotos;
const seenUrls = new Set<string>();
const photos = sourcePhotos.filter((photo) => {
  if (seenUrls.has(photo.url)) return false;
  seenUrls.add(photo.url);
  return true;
});
---

<BaseLayout
  seo={{
    title: "Photos",
    description: "A collection of photographs by Dane Wetton.",
  }}
>
  <section>
    <Wrapper variant="standard" class="py-24 lg:pt-32">
      <Text tag="h1" variant="textBase" class="font-medium text-base-900">
        Photos
      </Text>

      <div class="mt-4 columns-1 gap-4 sm:columns-2 lg:columns-3">
        {
          photos.map((photo, index) => (
            <figure class="mb-4 break-inside-avoid">
              <Image
                src={photo.url}
                alt={photo.alt}
                width={1600}
                height={1600}
                loading={index < 3 ? "eager" : "lazy"}
                decoding="async"
                class="h-auto w-full"
              />
            </figure>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
