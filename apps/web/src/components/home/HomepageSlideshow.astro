---
import { Image } from "astro:assets";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getImageUrl } from "@/lib/sanity";
import type { SanityImage } from "@/lib/sanity";

interface Props {
  images: SanityImage[];
}

const { images } = Astro.props;
const hasNavigation = images.length > 1;
---

<section data-home-slideshow class="min-h-[calc(100svh-3.5rem)]">
  <Wrapper
    variant="standard"
    class="flex min-h-[calc(100svh-3.5rem)] flex-col pb-4 2xl:max-w-none"
  >
    <div class="flex min-h-0 flex-1 flex-col">
      <div class="h-[calc(100svh-7.5rem)] min-h-80 overflow-hidden">
        {
          images.map((image, index) => (
            <figure
              data-slide
              aria-hidden={index === 0 ? "false" : "true"}
              class:list={[
                "size-full items-center justify-center",
                index === 0 ? "flex" : "hidden",
              ]}
            >
              <Image
                src={getImageUrl(image, { width: 2400, quality: 90 })}
                alt={image.alt ?? "Homepage photograph"}
                width={2400}
                height={1600}
                loading={index === 0 ? "eager" : "lazy"}
                class="h-auto w-auto max-h-[80%] max-w-[80%] object-contain"
              />
            </figure>
          ))
        }
      </div>

      {
        hasNavigation && (
          <div class="mt-3 flex items-center justify-center gap-1 text-xs text-base-900">
            <button
              type="button"
              data-previous
              class="transition duration-300 hover:text-base-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-900"
              aria-label="Show previous photograph"
            >
              prev
            </button>
            <span aria-hidden="true">/</span>
            <button
              type="button"
              data-next
              class="transition duration-300 hover:text-base-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-900"
              aria-label="Show next photograph"
            >
              next
            </button>
          </div>
        )
      }
    </div>

    <span data-status class="sr-only" aria-live="polite">
      Photograph 1 of {images.length}
    </span>
  </Wrapper>
</section>

<script>
  const slideshows = document.querySelectorAll<HTMLElement>(
    "[data-home-slideshow]"
  );

  slideshows.forEach((slideshow) => {
    const slides = Array.from(
      slideshow.querySelectorAll<HTMLElement>("[data-slide]")
    );
    const previousButtons = slideshow.querySelectorAll<HTMLButtonElement>(
      "[data-previous]"
    );
    const nextButtons = slideshow.querySelectorAll<HTMLButtonElement>("[data-next]");
    const status = slideshow.querySelector<HTMLElement>("[data-status]");

    if (slides.length < 2) return;

    let activeIndex = 0;
    let touchStartX = 0;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("flex", isActive);
        slide.classList.toggle("hidden", !isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      if (status) {
        status.textContent = `Photograph ${activeIndex + 1} of ${slides.length}`;
      }
    };

    previousButtons.forEach((button) =>
      button.addEventListener("click", () => showSlide(activeIndex - 1))
    );
    nextButtons.forEach((button) =>
      button.addEventListener("click", () => showSlide(activeIndex + 1))
    );

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.matches("input, textarea, select, [contenteditable='true']")) {
        return;
      }

      if (event.key === "ArrowLeft") showSlide(activeIndex - 1);
      if (event.key === "ArrowRight") showSlide(activeIndex + 1);
    });

    slideshow.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
      },
      { passive: true }
    );

    slideshow.addEventListener(
      "touchend",
      (event) => {
        const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
        const distance = touchEndX - touchStartX;

        if (Math.abs(distance) < 50) return;
        showSlide(distance > 0 ? activeIndex - 1 : activeIndex + 1);
      },
      { passive: true }
    );
  });
</script>
