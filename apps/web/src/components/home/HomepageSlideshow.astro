---
import { Image } from "astro:assets";
import { getImageUrl } from "@/lib/sanity";
import type { SanityImage } from "@/lib/sanity";

interface Props {
  images: SanityImage[];
}

const { images } = Astro.props;
const hasNavigation = images.length > 1;
---

<div data-home-slideshow>
  <div class="relative overflow-hidden bg-base-100">
    {
      images.map((image, index) => (
        <figure
          data-slide
          aria-hidden={index === 0 ? "false" : "true"}
          class:list={[index !== 0 && "hidden"]}
        >
          <Image
            src={getImageUrl(image, {
              width: 2000,
              height: 1250,
              quality: 90,
            })}
            alt={image.alt ?? "Homepage photograph"}
            width={2000}
            height={1250}
            loading={index === 0 ? "eager" : "lazy"}
            class="aspect-[4/3] w-full object-cover sm:aspect-[8/5]"
          />
        </figure>
      ))
    }
  </div>

  {
    hasNavigation && (
      <div class="mt-3 flex items-center justify-between">
        <button
          type="button"
          data-previous
          class="text-xs font-medium uppercase tracking-wide text-base-900 transition-colors hover:text-base-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-900"
          aria-label="Show previous photograph"
        >
          Previous
        </button>

        <span
          class="text-xs tabular-nums text-base-500"
          aria-live="polite"
        >
          <span data-current>1</span> / {images.length}
        </span>

        <button
          type="button"
          data-next
          class="text-xs font-medium uppercase tracking-wide text-base-900 transition-colors hover:text-base-500 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-900"
          aria-label="Show next photograph"
        >
          Next
        </button>
      </div>
    )
  }
</div>

<script>
  const slideshows = document.querySelectorAll<HTMLElement>(
    "[data-home-slideshow]"
  );

  slideshows.forEach((slideshow) => {
    const slides = Array.from(
      slideshow.querySelectorAll<HTMLElement>("[data-slide]")
    );
    const previous = slideshow.querySelector<HTMLButtonElement>("[data-previous]");
    const next = slideshow.querySelector<HTMLButtonElement>("[data-next]");
    const current = slideshow.querySelector<HTMLElement>("[data-current]");

    if (slides.length < 2 || !previous || !next) return;

    let activeIndex = 0;
    let touchStartX = 0;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("hidden", !isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      if (current) current.textContent = String(activeIndex + 1);
    };

    previous.addEventListener("click", () => showSlide(activeIndex - 1));
    next.addEventListener("click", () => showSlide(activeIndex + 1));

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.matches("input, textarea, select, [contenteditable='true']")) {
        return;
      }

      if (event.key === "ArrowLeft") showSlide(activeIndex - 1);
      if (event.key === "ArrowRight") showSlide(activeIndex + 1);
    });

    slideshow.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
      },
      { passive: true }
    );

    slideshow.addEventListener(
      "touchend",
      (event) => {
        const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
        const distance = touchEndX - touchStartX;

        if (Math.abs(distance) < 50) return;
        showSlide(distance > 0 ? activeIndex - 1 : activeIndex + 1);
      },
      { passive: true }
    );
  });
</script>
