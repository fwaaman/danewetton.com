---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Content
const { title, url, image } = {
  url: "/blog/posts/" + (Astro.props.post.slug ?? Astro.props.post.id),
  title: Astro.props.post.data.title,
  image: Astro.props.post.data.image.url,
};
---

<article
  class="relative flex flex-col border-t border-dashed border-white/20 group"
>
  <a href={url} title={title} class="absolute inset-0 z-10"> </a>
  <Image src={image} alt={title} width={1000} height={100} class="w-full" />
  <Text
    tag="h3"
    variant="textSM"
    class="mt-2 font-medium tracking-tight text-black duration-300"
    >{title}</Text
  >
</article>
